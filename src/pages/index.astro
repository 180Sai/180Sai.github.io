---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout title="Eric Cao — Engineer & Builder" description="Portfolio of projects, reports, and writing.">
  <h1>Eric Cao</h1>
  <p>Engineer. Self-hoster. Builder of grounded, verifiable search tooling.</p>

  <h2>Projects</h2>
  <ul class="entry-list">
    {
      projects.map((p) => (
        <li>
          <a href={`/projects/${p.id}/`}><h2>{p.data.title}</h2></a>
          <p>{p.data.description}</p>
        </li>
      ))
    }
  </ul>

  <h2>Recent posts</h2>
  <ul class="entry-list">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}><h2>{post.data.title}</h2></a>
          <p class="entry-meta">{post.data.pubDate.toISOString().slice(0, 10)}</p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>